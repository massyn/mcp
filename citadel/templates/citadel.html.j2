<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Citadel</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #0f0f0f;
      color: #e0e0e0;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* ── Sidebar ─────────────────────────────────────────────────────── */
    nav {
      width: 240px;
      min-width: 240px;
      background: #1a1a1a;
      border-right: 1px solid #2a2a2a;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    nav .brand {
      padding: 20px 16px 14px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #fff;
      border-bottom: 1px solid #2a2a2a;
    }

    nav .meta {
      padding: 8px 16px 10px;
      font-size: 0.72rem;
      color: #555;
      border-bottom: 1px solid #2a2a2a;
    }

    nav .room-list {
      overflow-y: auto;
      flex: 1;
      padding: 8px 0;
    }

    nav .room-list a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 16px;
      color: #aaa;
      text-decoration: none;
      font-size: 0.85rem;
      transition: background 0.15s, color 0.15s;
    }

    nav .room-list a:hover { background: #252525; color: #fff; }

    nav .room-list .count {
      font-size: 0.7rem;
      background: #2a2a2a;
      color: #666;
      border-radius: 10px;
      padding: 1px 7px;
      flex-shrink: 0;
    }

    nav .room-list .count.todo-count {
      background: #2a1f10;
      color: #c8843a;
    }

    nav .nav-divider {
      height: 1px;
      background: #2a2a2a;
      margin: 6px 0;
    }

    /* ── Sidebar room accordion ──────────────────────────────────────── */
    .room-item { position: relative; }

    .room-link {
      padding-left: 12px !important;
    }

    .room-link .chevron {
      font-size: 0.6rem;
      color: #444;
      margin-right: 6px;
      flex-shrink: 0;
      transition: transform 0.2s;
      display: inline-block;
    }

    .room-item.open .room-link .chevron { transform: rotate(90deg); }

    .room-link .room-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .entry-sublist {
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.2s ease;
    }

    .room-item.open .entry-sublist { max-height: 2000px; }

    .entry-sublink {
      display: block !important;
      padding: 5px 16px 5px 28px !important;
      font-size: 0.78rem !important;
      color: #666 !important;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      justify-content: unset !important;
    }

    .entry-sublink:hover { color: #ccc !important; }

    /* ── Main content ────────────────────────────────────────────────── */
    main {
      flex: 1;
      overflow-y: auto;
      padding: 32px 40px;
    }

    .room-section { margin-bottom: 56px; }

    .room-header {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid #2a2a2a;
    }

    .room-header h2 { font-size: 1.25rem; font-weight: 600; color: #fff; }
    .room-header .room-meta { font-size: 0.75rem; color: #555; }

    /* ── Tags ────────────────────────────────────────────────────────── */
    .tag {
      display: inline-block;
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 10px;
      background: #252525;
      color: #888;
      margin-right: 4px;
    }

    .tag.status-active     { background: #1a2e1a; color: #5c9e5c; }
    .tag.status-archived   { background: #2a2a1a; color: #9e9e5c; }
    .tag.status-deprecated { background: #2e1a1a; color: #9e5c5c; }

    /* ── Entry cards ─────────────────────────────────────────────────── */
    .entry-card {
      background: #1a1a1a;
      border: 1px solid #252525;
      border-radius: 8px;
      padding: 18px 20px;
      margin-bottom: 12px;
      transition: border-color 0.15s;
    }

    .entry-card:hover { border-color: #3a3a3a; }

    .entry-card summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .entry-card summary::-webkit-details-marker { display: none; }

    .entry-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .entry-title   { font-size: 0.95rem; font-weight: 600; color: #e8e8e8; }
    .entry-summary { font-size: 0.82rem; color: #888; line-height: 1.5; }
    .entry-meta    { font-size: 0.7rem; color: #444; }

    /* ── Markdown-rendered entry detail ─────────────────────────────── */
    details[open] .entry-detail {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #252525;
      font-size: 0.84rem;
      color: #bbb;
      line-height: 1.75;
    }

    .entry-detail h1, .entry-detail h2, .entry-detail h3,
    .entry-detail h4, .entry-detail h5, .entry-detail h6 {
      color: #ddd;
      font-weight: 600;
      margin: 1.1em 0 0.4em;
    }
    .entry-detail h1 { font-size: 1.1rem; }
    .entry-detail h2 { font-size: 1rem; }
    .entry-detail h3 { font-size: 0.93rem; }
    .entry-detail h4, .entry-detail h5, .entry-detail h6 { font-size: 0.87rem; }

    .entry-detail p { margin: 0.5em 0; }

    .entry-detail ul, .entry-detail ol {
      margin: 0.5em 0 0.5em 1.4em;
    }
    .entry-detail li { margin: 0.2em 0; }

    .entry-detail code {
      font-family: ui-monospace, monospace;
      font-size: 0.82em;
      background: #252525;
      color: #c8a96e;
      padding: 1px 5px;
      border-radius: 3px;
    }

    .entry-detail pre {
      background: #141414;
      border: 1px solid #2a2a2a;
      border-radius: 6px;
      padding: 12px 14px;
      overflow-x: auto;
      margin: 0.7em 0;
    }

    .entry-detail pre code {
      background: none;
      color: #ccc;
      padding: 0;
      font-size: 0.81em;
    }

    .entry-detail blockquote {
      border-left: 3px solid #3a3a3a;
      margin: 0.6em 0;
      padding: 4px 14px;
      color: #777;
    }

    .entry-detail a { color: #6a9fd8; text-decoration: none; }
    .entry-detail a:hover { text-decoration: underline; }

    .entry-detail table {
      border-collapse: collapse;
      width: 100%;
      margin: 0.7em 0;
      font-size: 0.82em;
    }
    .entry-detail th, .entry-detail td {
      border: 1px solid #2a2a2a;
      padding: 6px 10px;
      text-align: left;
    }
    .entry-detail th { background: #1e1e1e; color: #ccc; }

    .entry-detail hr {
      border: none;
      border-top: 1px solid #2a2a2a;
      margin: 1em 0;
    }

    /* ── Todo table ──────────────────────────────────────────────────── */
    .todo-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.83rem;
      margin-bottom: 8px;
    }

    .todo-table th {
      text-align: left;
      padding: 6px 10px;
      font-size: 0.72rem;
      color: #555;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-bottom: 1px solid #2a2a2a;
    }

    .todo-table td {
      padding: 9px 10px;
      border-bottom: 1px solid #1e1e1e;
      vertical-align: top;
    }

    .todo-table tr:last-child td { border-bottom: none; }
    .todo-table tr:hover td { background: #161616; }

    .todo-id { color: #444; font-size: 0.75rem; font-family: ui-monospace, monospace; white-space: nowrap; }
    .todo-title { color: #ddd; }
    .todo-due { color: #666; font-size: 0.78rem; white-space: nowrap; }
    .todo-room a { color: #6a9fd8; text-decoration: none; font-size: 0.78rem; }
    .todo-room a:hover { text-decoration: underline; }

    .priority-badge {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: ui-monospace, monospace;
    }
    .p1 { background: #3a1010; color: #e05c5c; }
    .p2 { background: #2e1e0a; color: #c8843a; }
    .p3 { background: #252515; color: #a0a040; }
    .p4 { background: #102a10; color: #5c9e5c; }
    .p5 { background: #1a1a2e; color: #5c5c9e; }

    .todo-status {
      display: inline-block;
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 10px;
      white-space: nowrap;
    }
    .s-open        { background: #1e1e1e; color: #666; }
    .s-in_progress { background: #0f1f30; color: #4a90c8; }
    .s-blocked     { background: #2e1a10; color: #c8643a; }
    .s-deferred    { background: #1e1028; color: #8a5cb8; }

    .no-entries { font-size: 0.82rem; color: #444; font-style: italic; }

    /* ── Scrollbar ───────────────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 3px; }
  </style>
</head>
<body>

<nav>
  <div class="brand">Citadel</div>
  <div class="meta">{{ total_rooms }} rooms &middot; {{ total_entries }} entries<br>{{ generated_at }}</div>
  <div class="room-list">
    {% if todos %}
    <a href="#todos">
      Todos
      <span class="count todo-count">{{ total_todos }}</span>
    </a>
    <div class="nav-divider"></div>
    {% endif %}
    {% for room in rooms %}
    <div class="room-item">
      <a class="room-link" href="#room-{{ room.name }}" data-room="{{ room.name }}">
        <span class="chevron">&#9654;</span>
        <span class="room-name">{{ room.name }}</span>
        <span class="count">{{ room.entries | length }}</span>
      </a>
      {% if room.entries %}
      <div class="entry-sublist" id="sub-{{ room.name }}">
        {% for entry in room.entries %}
        <a class="entry-sublink" href="#entry-{{ entry.id }}" data-entry="{{ entry.id }}">{{ entry.title }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</nav>

<main>

  {% if todos %}
  <section class="room-section" id="todos">
    <div class="room-header">
      <h2>Todos</h2>
      <span class="room-meta">{{ total_todos }} open item{{ 's' if total_todos != 1 }}</span>
    </div>
    <table class="todo-table">
      <thead>
        <tr>
          <th>#</th>
          <th>P</th>
          <th>Title</th>
          <th>Room</th>
          <th>Status</th>
          <th>Due</th>
        </tr>
      </thead>
      <tbody>
        {% for todo in todos %}
        <tr>
          <td class="todo-id">{{ todo.id }}</td>
          <td><span class="priority-badge p{{ todo.priority }}">P{{ todo.priority }}</span></td>
          <td class="todo-title">{{ todo.title }}</td>
          <td class="todo-room"><a href="#room-{{ todo.room }}">{{ todo.room }}</a></td>
          <td><span class="todo-status s-{{ todo.status }}">{{ todo.status.replace('_', ' ') }}</span></td>
          <td class="todo-due">{{ todo.due_date or '' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% for room in rooms %}
  <section class="room-section" id="room-{{ room.name }}">
    <div class="room-header">
      <h2>{{ room.name }}</h2>
      <span class="room-meta">updated {{ room.updated_on[:10] }}</span>
      {% for tag in room.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
    </div>

    {% if room.entries %}
      {% for entry in room.entries %}
      <details class="entry-card" id="entry-{{ entry.id }}">
        <summary>
          <div class="entry-title-row">
            <span class="entry-title">{{ entry.title }}</span>
            <span class="tag status-{{ entry.status }}">{{ entry.status }}</span>
            {% for tag in entry.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
          </div>
          <div class="entry-summary">{{ entry.summary }}</div>
          <div class="entry-meta">{{ entry.updated_on[:10] }}</div>
        </summary>
        <div class="entry-detail">{{ entry.detail_html | safe }}</div>
      </details>
      {% endfor %}
    {% else %}
      <p class="no-entries">No entries in this room.</p>
    {% endif %}
  </section>
  {% endfor %}

</main>

<script>
  document.querySelectorAll('.room-link').forEach(function(link) {
    link.addEventListener('click', function() {
      this.closest('.room-item').classList.toggle('open');
    });
  });

  document.querySelectorAll('.entry-sublink').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var details = document.getElementById('entry-' + this.dataset.entry);
      if (details) {
        details.open = true;
        details.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

</body>
</html>
