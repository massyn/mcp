# -----------------------------------------------------------------------
# Citadel MCP — configuration
# Copy this file to .env and fill in the values you need.
# -----------------------------------------------------------------------

# Database path (local SQLite)
# Defaults to ~/.citadel/citadel.db if not set.
# Supports ~ expansion.
# DB_PATH=~/.citadel/citadel.db

# Turso remote database
# If both TURSO_URL and TURSO_TOKEN are set, Turso is used instead of
# local SQLite. Leave both commented out to use local SQLite.
# TURSO_URL=libsql://your-database.turso.io  (libsql:// is auto-converted to https://)
# TURSO_TOKEN=your-auth-token-here
