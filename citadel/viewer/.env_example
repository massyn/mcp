# Citadel Viewer — configuration
# Copy to .env and fill in values.

# Port to listen on (default 5000) — FLASK_PORT takes precedence over PORT
# FLASK_PORT=5000

# Enable Flask debug mode (never use in production)
# FLASK_DEBUG=0

# --- Citadel MCP connection ---
# Authentication token for the Citadel MCP endpoint
# CITADEL_TOKEN=your-token-here

# Citadel MCP endpoint URL
# CITADEL_MCP_ENDPOINT=https://mcp.example.com/citadel
