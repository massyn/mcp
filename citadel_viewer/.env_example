# Citadel Viewer — configuration
# Copy to .env and fill in values.

# Port to listen on (default 5000) — FLASK_PORT takes precedence over PORT
# FLASK_PORT=5000

# Enable Flask debug mode (never use in production)
# FLASK_DEBUG=0

# --- Citadel database (forwarded to citadel/server.py) ---
# Local SQLite path (defaults to ~/.citadel/citadel.db)
# DB_PATH=~/.citadel/citadel.db

# Turso remote database (if set, takes precedence over local SQLite)
# TURSO_URL=libsql://your-database.turso.io
# TURSO_TOKEN=your-auth-token-here
